{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I '/home/alfeim/AlgoLand/.codex/hooks/guard_bash.py'",
            "timeout": 10,
            "statusMessage": "Verificando comando"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I '/home/alfeim/AlgoLand/.codex/hooks/validar_json.py'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
