[sub_resource type="GDScript" id="Captura"]
script/source = "extends Node3D

func _ready() -> void:
	$Camera3D.look_at(Vector3(-0.25, 1.85, 0.1))
	var destino := \"\"
	for argumento in OS.get_cmdline_user_args():
		if argumento.begins_with(\"--captura=\"):
			destino = argumento.trim_prefix(\"--captura=\")
	if destino.is_empty():
		return
	await get_tree().create_timer(1.0).timeout
	await RenderingServer.frame_post_draw
	get_viewport().get_texture().get_image().save_png(destino)
	get_tree().quit()
"

