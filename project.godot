; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[GDScript_Formatter]

format_on_save=175
fast_but_unsafe=175

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="top down"
run/main_scene="res://cenas/inicio-do-jogo.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=60
config/icon="res://Tiles/icon.svg"

[autoload]

DadosDosItems="*res://Codigos/DadosLocais/Dados-dos-items-loja.gd"
DadosJogo="*res://Codigos/DadosLocais/Dados-do-jogo.gd"
GDConsole="*res://addons/gdconsole/gdconsole.gd"
EventosJogo="*res://Codigos/Globais/eventos_jogo.gd"
InventarioJogador="*res://Codigos/Modelos/modelo_inventario.gd"
PreviewArrasto="*res://Codigos/UI/preview_arrasto.gd"

[display]

window/size/viewport_width=576
window/size/viewport_height=324
window/size/mode=3
window/size/resizable=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/function_type_autocomplete/plugin.cfg", "res://addons/gdconsole/plugin.cfg", "res://addons/gdscript_formatter/plugin.cfg", "res://addons/msca/plugin.cfg", "res://addons/tnowe_extra_controls/plugin.cfg")

[global_group]

enemy=""
espada_basica=""
escudo_basico=""
lanca_basica=""
cabeca_basica=""
armadura_basica=""
botas_basicas=""
luvas_basicas=""

